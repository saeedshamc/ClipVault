#!/usr/bin/env bash
# Strip IDE-injected attribution trailers before commit-msg validation.
# Only removes known trailer lines; does not rewrite the subject/body.

MSG_FILE="$1"
if [[ ! -f "$MSG_FILE" ]]; then
  exit 0
fi

tmp="$(mktemp)"
# Drop lines that are pure attribution trailers injected by tooling.
grep -viE '^[[:space:]]*Co-authored-by:|^[[:space:]]*Signed-off-by:[[:space:]]*.*(cursor|copilot|openai|anthropic)|cursoragent@' "$MSG_FILE" > "$tmp" || true
# Also drop standalone "Generated with/by ..." lines often appended by IDEs.
grep -viE '^[[:space:]]*Generated with|^[[:space:]]*Generated by|^[[:space:]]*Made-with:' "$tmp" > "${tmp}.2" || true
mv "${tmp}.2" "$MSG_FILE"
rm -f "$tmp"
exit 0
