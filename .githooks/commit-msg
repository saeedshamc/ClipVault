#!/usr/bin/env bash
# Reject commit messages that contain AI/tool attribution markers.
# Exit 0 = accept, exit 1 = reject.

MSG_FILE="$1"
if [[ ! -f "$MSG_FILE" ]]; then
  echo "commit-msg: missing message file" >&2
  exit 1
fi

# Case-insensitive match against forbidden patterns.
if grep -qiE 'cursor|cursoragent|co-authored-by|generated by|generated with|ai-generated|copilot|claude|chatgpt|openai|anthropic' "$MSG_FILE"; then
  echo "commit-msg: rejected — message contains a forbidden attribution/AI marker." >&2
  echo "commit-msg: remove references to tools/AI and commit again." >&2
  exit 1
fi

exit 0
